# Public hostname handled by Caddy. Use localhost for local Docker testing.
APP_DOMAIN=localhost
APP_ENV=development

# PostgreSQL container and application connection.
POSTGRES_DB=meattrack
POSTGRES_ADMIN_USER=meattrack_admin
POSTGRES_ADMIN_PASSWORD=replace_with_a_long_random_admin_password
APP_DB_USER=meattrack_app
APP_DB_PASSWORD=replace_with_a_different_long_random_app_password
DATABASE_URL=postgresql://meattrack_app:replace_with_a_different_long_random_app_password@db:5432/meattrack
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=5

# Generate these independently; never commit the real values.
SESSION_SECRET_KEY=replace_with_at_least_32_random_bytes

# Development-only classroom seed accounts. Production Compose does not pass
# these values to the application container.
OWNER_PASSWORD=replace_with_a_unique_owner_password
TEAM_LEADER_PASSWORD=replace_with_a_unique_team_leader_password
RESELLER_PASSWORD=replace_with_a_unique_reseller_password

# Temporary password used when an owner creates an operational account.
DEFAULT_ACCOUNT_PASSWORD=replace_with_a_unique_temporary_password

# Optional hosted chatbot configuration.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=
